{
  "name": "api-rest-auth-roles",
  "version": "1.0.0",
  "description": "API REST profesional con autenticación JWT y control de acceso por roles (Node.js, Express, MongoDB).",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
